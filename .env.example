# Copia este archivo como ".env" y completa con tus propios valores reales.
# NUNCA subas el archivo ".env" a git (ya está en .gitignore, no lo quites).

# --- SEO ---
# URL pública del sitio, sin "/" final. La usan el sitemap, robots.txt, las
# URLs canónicas y los datos estructurados. Si no se define, usa
# https://dogtoraliavet.cl
NEXT_PUBLIC_SITE_URL=https://dogtoraliavet.cl

# --- Instagram (feed de fotos en el inicio) ---
# Solo lo usa el servidor (src/app/api/instagram/route.ts); nunca llega al
# navegador. Es un token de larga duración que hay que renovar antes de que
# expire (~60 días). Si está vencido o vacío, la sección simplemente no se
# muestra.
INSTAGRAM_ACCESS_TOKEN=

# --- Correo del formulario de contacto (Resend) ---
# Se genera en resend.com → API Keys, usando el dominio ya verificado.
# Sin esta clave el formulario de contacto no puede enviar correos.
RESEND_API_KEY=
# Remitente que verán los destinatarios (debe ser de un dominio
# verificado en Resend, ej: notificaciones@dogtoraliavet.cl).
CONTACT_FROM_EMAIL=Dogtoralia <notificaciones@dogtoraliavet.cl>

# --- Rate limiting (Upstash Redis) ---
# Contador compartido para limitar solicitudes por IP en /api/contact,
# /api/instagram y /api/products. Se crea gratis en console.upstash.com →
# Redis → Create database → pestaña "REST API".
# Si conectas Upstash desde Vercel (Storage / Integrations), Vercel crea
# KV_REST_API_URL y KV_REST_API_TOKEN: también sirven y no hace falta
# definir estas dos.
# En producción son OBLIGATORIAS: sin ellas esas rutas responden 503.
# En desarrollo (npm run dev) se usa un contador en memoria si faltan.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Solo para probar `npm run build && npm run start` en tu computador sin
# Upstash. Se ignora en Vercel. No la definas en producción.
# RATE_LIMIT_MEMORY_FALLBACK=1
