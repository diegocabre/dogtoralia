# Copia este archivo como ".env" y completa con tus propios valores reales.
# NUNCA subas el archivo ".env" a git (ya está en .gitignore, no lo quites).

# --- Instagram (feed de fotos en el inicio) ---
# Solo lo usa el servidor (src/app/api/instagram/route.ts); nunca llega al
# navegador. Es un token de larga duración que hay que renovar antes de que
# expire (~60 días). Si está vencido o vacío, la sección simplemente no se
# muestra.
INSTAGRAM_ACCESS_TOKEN=

# --- Correo del formulario de contacto (Resend) ---
# Se genera en resend.com → API Keys, usando el dominio ya verificado.
# Sin esta clave el formulario de contacto no puede enviar correos.
RESEND_API_KEY=
# Remitente que verán los destinatarios (debe ser de un dominio
# verificado en Resend, ej: notificaciones@dogtoraliavet.cl).
CONTACT_FROM_EMAIL=Dogtoralia <notificaciones@dogtoraliavet.cl>
