# Copia este archivo como ".env" y completa con tus propios valores reales.
# NUNCA subas el archivo ".env" a git (ya está en .gitignore, no lo quites).

# --- Instagram (feed de fotos) ---
# OJO: sin NEXT_PUBLIC_, este token ahora solo lo usa el servidor
# (ver src/app/api/instagram/route.ts). Es un token de larga duración
# que hay que renovar antes de que expire (~60 días).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=

# --- Correo del formulario de contacto (Resend) ---
# Reemplaza las contraseñas de aplicación de Gmail que se usaban antes.
# Se genera en resend.com → API Keys, usando el dominio ya verificado.
RESEND_API_KEY=
# Remitente que verán los destinatarios (debe ser de un dominio
# verificado en Resend, ej: notificaciones@dogtoraliavet.cl).
CONTACT_FROM_EMAIL=Dogtoralia <notificaciones@dogtoraliavet.cl>

# --- (Deprecado) Gmail app passwords ---
# Ya no se usan tras migrar a Resend. Puedes revocarlas desde
# myaccount.google.com/apppasswords una vez que confirmes que los
# correos llegan bien con Resend.
# EMAIL_USER_PUENTE_ALTO=
# EMAIL_PASSWORD_PUENTE_ALTO=
# EMAIL_USER_CENTRO=
# EMAIL_PASSWORD_CENTRO=

# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Firebase (públicas, van al bundle del cliente) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
